{
  "name": "bb-plugin-crm",
  "version": "0.1.0",
  "description": "A local-first, agent-native CRM workspace for BB.",
  "license": "MIT",
  "homepage": "https://github.com/juanbermudez/bb-plugin-crm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanbermudez/bb-plugin-crm.git"
  },
