    "components",
    "dist",
    "docs",
    "lib",
    "skills",
    "app.tsx",
    "server.ts",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "bb-plugin",
    "crm",
    "sales",
    "contacts",
    "deals",
    "agents"
  ],
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
